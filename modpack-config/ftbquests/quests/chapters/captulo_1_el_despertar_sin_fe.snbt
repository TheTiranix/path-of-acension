				type: "item"
			}]
			title: "Un Eco en la Oscuridad"
			x: 0.0d
			y: -0.5d
		}
		{
			dependencies: ["3CDDDA4E4BA3B574"]
			dependency_requirement: "all_started"
			description: ["Mientras buscaba entre las ruinas de este mundo muerto, encontré algo... diferente. Un cristal que pulsa con una luz tenue y susurra ecos de un tiempo olvidado. No es un mineral. Es un recuerdo, una pieza del alma rota de este mundo. Siento que debo reunir más de estos..."]
			id: "0FB8A71917E13644"
			progression_mode: "linear"
			rewards: [
				{
					id: "0DF2AA65239A54D1"
