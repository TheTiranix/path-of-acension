		}
		{
			dependencies: ["3CDDDA4E4BA3B574"]
			description: ["Los muertos no descansan. Se arrastran fuera de sus tumbas, con la carne podrida y los ojos vacíos. No son monstruos sin mente; son un recordatorio de lo que nos espera a todos si fallamos. Debo limpiar esta plaga, al menos en mi pequeño rincón de este infierno."]
			icon: "minecraft:rotten_flesh"
			id: "189961DE9070A239"
