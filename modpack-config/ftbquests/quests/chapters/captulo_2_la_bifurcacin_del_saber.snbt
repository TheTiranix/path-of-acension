	order_index: 1
	quest_links: [ ]
	quests: [
		{
			dependencies: ["0FB8A71917E13644"]
			description: ["Los Fragmentos de Memoria resuenan en mi mente. Ya no veo el mundo como antes. Percibo... tensiones. Una lucha silenciosa entre fuerzas que no comprendo. Una energía salvaje y sangrienta que emana de la tierra, una lógica fría y metálica que yace dormida en la piedra, y un eco de orden casi divino en los patrones del mundo. Para entender, debo ver más allá de mis ojos mortales."]
			id: "25A7A88A2D621E5F"
			rewards: [{
				id: "7496E2BB9510C297"
				type: "xp"
				xp: 200
			}]
			size: 2.5d
			subtitle: "Tus ojos se han abierto. Tres caminos se revelan ante ti. Elige sabiamente, pues no se puede servir a dos señores."
			tasks: [{
				id: "6A4D6E219CF0C158"
