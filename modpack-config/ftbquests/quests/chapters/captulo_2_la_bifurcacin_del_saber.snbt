		}
		{
			dependencies: ["25A7A88A2D621E5F"]
			dependency_requirement: "one_completed"
			description: ["Entre el caos de la sangre y la frialdad del acero, existe un camino intermedio. El poder de la intención, de dar forma a la realidad a través de la voluntad y el conocimiento. No es un pacto, es un estudio. Para empezar, necesito un lienzo para mis pensamientos, un lugar donde anotar las palabras de poder que empiezan a formarse en mi mente."]
			id: "07C3BBEF32DCC0B3"
