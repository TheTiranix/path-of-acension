		}
		{
			dependencies: ["1F34465FCBAC96F5"]
			description: ["El universo no es caótico, es un gran mecanismo. Cada río que fluye, cada ráfaga de viento, es energía esperando ser aprovechada. Rechazo los susurros de los dioses y abrazo la certeza de la física. La energía cinética será mi primer dogma."]
			icon: "create:water_wheel"
			id: "397BB22C8F3AC751"
			rewards: [
